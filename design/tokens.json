{
  "_comment": "Source unique du thème (Phase 0). Identité : bleu de travail + ruban de pointeuse. Après modification : python3 scripts/gen_theme.py puis python3 scripts/build_prototype.py",
  "colors": {
    "background":     {"light": "#EDF0F5", "dark": "#0E131D", "amoled": "#000000"},
    "surface":        {"light": "#FFFFFF", "dark": "#182030", "amoled": "#0C0F15"},
    "surfaceRaised":  {"light": "#F5F7FA", "dark": "#212B3E", "amoled": "#151A23"},
    "fill":           {"light": "#E0E5EE", "dark": "#2A3449", "amoled": "#1C222D"},
    "separator":      {"light": "#D3D9E4", "dark": "#2E384C", "amoled": "#1F2631"},
    "textPrimary":    {"light": "#101726", "dark": "#EEF2FA", "amoled": "#EEF2FA"},
    "textSecondary":  {"light": "#4A566C", "dark": "#A9B4C9", "amoled": "#A3AEC4"},
    "textTertiary":   {"light": "#5F6A7F", "dark": "#909CB4", "amoled": "#8490A8"},
    "accent":         {"light": "#2447B8", "dark": "#93ABFF", "amoled": "#93ABFF"},
    "accentOn":       {"light": "#FFFFFF", "dark": "#0A1230", "amoled": "#0A1230"},
    "accentSoft":     {"light": "#DCE4FA", "dark": "#22305C", "amoled": "#141D3D"},
    "work":           {"light": "#146B45", "dark": "#5FCD96", "amoled": "#5FCD96"},
    "workSoft":       {"light": "#D8EEE2", "dark": "#173B2C", "amoled": "#0F2A1F"},
    "study":          {"light": "#962A70", "dark": "#F09ACF", "amoled": "#F09ACF"},
    "studySoft":      {"light": "#F5DEEB", "dark": "#47223D", "amoled": "#30162A"},
    "errand":         {"light": "#755400", "dark": "#EDBA52", "amoled": "#EDBA52"},
    "errandSoft":     {"light": "#F5E9C8", "dark": "#41310F", "amoled": "#2C2109"},
    "danger":         {"light": "#B82828", "dark": "#FF8A81", "amoled": "#FF8A81"},
    "dangerOn":       {"light": "#FFFFFF", "dark": "#3A0B08", "amoled": "#3A0B08"},
    "dangerSoft":     {"light": "#F9DEDC", "dark": "#4C201E", "amoled": "#341514"},
    "warning":        {"light": "#99440A", "dark": "#FFA465", "amoled": "#FFA465"},
    "warningSoft":    {"light": "#FAE0CC", "dark": "#48290F", "amoled": "#301A09"},
    "success":        {"light": "#146B45", "dark": "#5FCD96", "amoled": "#5FCD96"}
  },
  "radius": {"small": 8, "medium": 14, "large": 22, "sheet": 28, "pill": 999},
  "spacing": {"xxs": 2, "xs": 4, "s": 8, "m": 16, "l": 24, "xl": 32, "xxl": 48},
  "typography": {
    "_comment": "Texte : SF Pro (système). Chiffres, heures, chronos : SF Mono (design .monospaced), comme un ticket de pointeuse. Tailles = styles Dynamic Type iOS.",
    "fontText": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', system-ui, 'Segoe UI', Roboto, sans-serif",
    "fontMono": "ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace",
    "styles": {
      "largeTitle": {"size": 34, "line": 41, "weight": 700},
      "title1":     {"size": 28, "line": 34, "weight": 700},
      "title2":     {"size": 22, "line": 28, "weight": 700},
      "title3":     {"size": 20, "line": 25, "weight": 600},
      "headline":   {"size": 17, "line": 22, "weight": 600},
      "body":       {"size": 17, "line": 22, "weight": 400},
      "callout":    {"size": 16, "line": 21, "weight": 400},
      "subhead":    {"size": 15, "line": 20, "weight": 400},
      "footnote":   {"size": 13, "line": 18, "weight": 400},
      "caption":    {"size": 12, "line": 16, "weight": 500},
      "timer":      {"size": 46, "line": 50, "weight": 600},
      "figure":     {"size": 28, "line": 32, "weight": 600}
    }
  },
  "shadows": {
    "_comment": "Noir, opacité par mode. En AMOLED les ombres sont invisibles : la hiérarchie passe par surface / surfaceRaised / separator.",
    "card":  {"y": 1,  "blur": 2,  "opacity": {"light": 0.06, "dark": 0.30, "amoled": 0}},
    "float": {"y": 8,  "blur": 24, "opacity": {"light": 0.16, "dark": 0.50, "amoled": 0}},
    "sheet": {"y": -8, "blur": 32, "opacity": {"light": 0.18, "dark": 0.55, "amoled": 0}}
  },
  "motion": {
    "_comment": "Durées en secondes. Animations discrètes, coupées si Réduire les animations.",
    "fast": 0.15, "normal": 0.28, "slow": 0.45,
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easeSheet": "cubic-bezier(0.32, 0.72, 0, 1)"
  },
  "haptics": {
    "_comment": "Événement UI vers retour haptique UIKit (Phase 2). Désactivables dans Réglages.",
    "tabChange": "selection",
    "toggle": "impact.light",
    "segmentChange": "selection",
    "primaryAction": "impact.medium",
    "sessionStart": "notification.success",
    "sessionStop": "notification.success",
    "confirm": "notification.success",
    "doubtChoice": "selection",
    "undo": "impact.light",
    "destructive": "notification.warning",
    "error": "notification.error"
  }
}
